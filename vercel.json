{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/science/:chapter", "destination": "/science", "permanent": true },
    { "source": "/wildlife", "destination": "/species", "permanent": true },
    { "source": "/visit", "destination": "/posada-natura", "permanent": true },
    { "source": "/ecotour", "destination": "/posada-natura", "permanent": true },
    { "source": "/donate", "destination": "/support", "permanent": true },
    { "source": "/donor-ask", "destination": "/support", "permanent": true },
    { "source": "/contact", "destination": "/about", "permanent": true },
    { "source": "/about-5", "destination": "/about", "permanent": true },
    { "source": "/media", "destination": "/about", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/es", "destination": "/", "permanent": true },
    { "source": "/es/:path*", "destination": "/", "permanent": true },
    { "source": "/wildland-cooperative", "destination": "/", "permanent": true }
  ]
}
